// mm.rc — config dialog, screensaver name, and version info.
// ASCII only (rc.exe compiles with the system codepage; non-ASCII here turns into mojibake).
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Font Embedding
IDR_MATRIX_FONT RCDATA "Matrix-Code.ttf"

// The classic screensaver-name convention: string id 1 is shown by the Windows
// "Screen Saver Settings" control panel.
STRINGTABLE
BEGIN
    1   "Matrix Reflow"
END

// Page 1 of the config dialog's tab control: every slider in the app, grouped
// together and positioned directly under the live preview by the host dialog
// (see PositionPages() in config.cpp).
// This is a child-dialog "page" template, not shown standalone -- IDD_CONFIG 
// creates it into the IDC_TAB display area.
IDD_PAGE_SLIDERS DIALOGEX 0, 0, 270, 190
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    // Titles are CTEXT spanning the full page width (0..272) so they land as
    // close to mathematically centered as possible regardless of string
    // length, and are re-fonted bold at runtime (see BoldenTitles() in
    // config.cpp -- .rc dialog templates can't mix font weights directly).
    // Density/Size are shorter inline labels beside half-width sliders
    // rather than full-width CTEXT titles, but are bolded the same way via
    // their own IDC_TITLE_DENSITY / IDC_TITLE_SIZE ids.
    CTEXT           "Falling speed", IDC_TITLE_SPEED, 0, 4, 272, 9
    LTEXT           "Slow", IDC_STATIC, 8, 14, 26, 9
    CONTROL         "", IDC_SPEED, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 13, 208, 15
    RTEXT           "Fast", IDC_STATIC, 240, 14, 24, 9

    // Density/Size get their own title IDs (IDC_TITLE_DENSITY / IDC_TITLE_SIZE)
    // so BoldenTitles() in config.cpp can re-font them bold like the other
    // section titles, even though they're short inline labels beside
    // half-width sliders rather than full-width CTEXT titles.
    LTEXT           "Density:", IDC_TITLE_DENSITY, 4, 31, 38, 8
    CONTROL         "", IDC_DENSITY, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 32, 29, 95, 15
    
    LTEXT           "Size:", IDC_TITLE_SIZE, 130, 31, 42, 8
    CONTROL         "", IDC_GLYPH_SCALE, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 145, 29, 95, 15
    LTEXT           "Small sizes impact CPU!", IDC_WARNING_GLYPH, 149, 44, 119, 8, NOT WS_VISIBLE

    CTEXT           "Column length", IDC_TITLE_LENGTH, 0, 54, 272, 9
	LTEXT           "Short", IDC_STATIC, 8, 64, 26, 9
    CONTROL         "", IDC_LENGTH_BIAS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 63, 208, 15
	RTEXT           "Long", IDC_STATIC, 240, 64, 28, 9

    CTEXT           "Screen curvature", IDC_TITLE_CURVATURE, 0, 80, 272, 9
    LTEXT           "Flat", IDC_STATIC, 8, 90, 26, 9
    CONTROL         "", IDC_DISTORTION, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 89, 208, 15
    RTEXT           "Curved", IDC_STATIC, 240, 90, 28, 9

    CTEXT           "Scene depth", IDC_TITLE_DEPTH, 0, 106, 272, 9
    LTEXT           "2D", IDC_STATIC, 8, 116, 26, 9
    CONTROL         "", IDC_DEPTH, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 115, 208, 15
    RTEXT           "3D", IDC_STATIC, 240, 116, 28, 9

    CTEXT           "Glow intensity", IDC_TITLE_GLOW, 0, 132, 272, 9
    LTEXT           "Subtle", IDC_STATIC, 8, 142, 26, 9
    CONTROL         "", IDC_GLOW, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 141, 208, 15
    RTEXT           "Intense", IDC_STATIC, 240, 142, 28, 9

    CTEXT           "3D Camera speed", IDC_TITLE_CAMSPEED, 0, 158, 272, 9
    LTEXT           "Still", IDC_STATIC, 8, 168, 26, 9
    CONTROL         "", IDC_CAMSPEED, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 167, 208, 15
    RTEXT           "Fast", IDC_STATIC, 240, 168, 24, 9

    CTEXT           "Mutation rate", IDC_TITLE_MUTATION, 0, 184, 272, 9
    LTEXT           "Stable", IDC_STATIC, 8, 194, 26, 9
    CONTROL         "", IDC_MUTATION, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 32, 193, 208, 15
    RTEXT           "Chaotic", IDC_STATIC, 240, 194, 30, 9
END

// Page 2 of the config dialog's tab control: on/off toggles, the easter-egg
// (glitch) switch, and the project link.
IDD_PAGE_OPTIONS DIALOGEX 0, 0, 270, 190
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    // Color Theme + Profiles now lead the page (previously buried in the
    // middle). Both blocks are bolded like the page-1 slider titles for a
    // consistent look (see BoldenTitles() in config.cpp).
    LTEXT           "Color Theme", IDC_TITLE_COLORTHEME, 4, 4, 120, 9
    LTEXT           "Preset:", IDC_STATIC, 4, 19, 30, 8
    COMBOBOX        IDC_PRESET_COMBO, 36, 16, 112, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Main Color...",   IDC_COLOR_MAIN, 152, 16, 58, 14
    PUSHBUTTON      "Glitch Color...", IDC_COLOR_GLITCH, 212, 16, 58, 14

    LTEXT           "Profiles (save up to 5 configurations)", IDC_TITLE_PROFILES, 4, 34, 220, 8
    COMBOBOX        IDC_PROFILE_COMBO, 4, 45, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_PROFILE_NAME, 88, 45, 92, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Save",   IDC_PROFILE_SAVE, 184, 44, 28, 14
    PUSHBUTTON      "Load",   IDC_PROFILE_LOAD, 214, 44, 28, 14
    PUSHBUTTON      "Delete", IDC_PROFILE_DELETE, 244, 44, 24, 14

    // Display toggles, compacted into a tight 2-column grid.
    AUTOCHECKBOX    "Textured",        IDC_TEXTURED, 4, 65, 130, 10
    AUTOCHECKBOX    "Wireframe",       IDC_WIREFRAME, 149, 65, 130, 10
    AUTOCHECKBOX    "Show frame rate", IDC_SHOWFPS,  4, 79, 130, 10
    AUTOCHECKBOX    "Bloom glow",      IDC_BLOOM,    149, 79, 130, 10
    AUTOCHECKBOX    "HDR highlights",  IDC_HDR,      4, 93, 130, 10
    AUTOCHECKBOX    "Easter eggs",     IDC_EASTEREGGS, 149, 93, 130, 10
    // Column split is asymmetric here (80 / 178 instead of 149/149) because
    // the CRT filter label is much longer than the other checkboxes and was
    // getting cramped into the same 130-wide column as everything else.
    AUTOCHECKBOX    "60 FPS Cap", IDC_BATTERYSAVER, 4, 107, 80, 10
    AUTOCHECKBOX    "CRT filter", IDC_CRT_EMULATION, 149, 107, 178, 10

    LTEXT           "Glyph Rendering", IDC_TITLE_GLYPHREND, 4, 123, 120, 9
    AUTOCHECKBOX    "Flip Glyphs Horizontally", IDC_FLIPX, 4, 134, 140, 10
    AUTOCHECKBOX    "Flip Glyphs Vertically",   IDC_FLIPY, 149, 134, 140, 10
    AUTOCHECKBOX    "Binary Mode (0/1 only)",   IDC_BINARYMODE, 4, 148, 140, 10
    AUTOCHECKBOX    "Column Gaps",              IDC_COLUMN_GAPS, 149, 148, 140, 10
    AUTOCHECKBOX    "Extra-contrast heads",     IDC_EXTRA_CONTRAST_HEADS, 4, 162, 150, 10

    CONTROL         "<a href=""https://github.com/Delmay441/ModernMatrixScreensaver-with-Rezmason-font"">Project on GitHub</a>",
                    IDC_LINK, "SysLink", WS_TABSTOP, 4, 178, 200, 10
END

IDD_CONFIG DIALOGEX 0, 0, 300, 396
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Matrix Reflow - Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    // Live preview surface (a child render window is created over this placeholder).
    // Bumped up a few units (was y=7) now that everything below it is tighter.
    CONTROL         "", IDC_PREVIEW, "Static", SS_BLACKRECT | WS_VISIBLE, 10, 4, 280, 118

    // Tab control directly below the preview; its two pages (IDD_PAGE_SLIDERS /
    // IDD_PAGE_OPTIONS) are created and positioned into its display area at
    // runtime by config.cpp -- see PositionPages()/ShowPage(). Height (240)
    // is condensed down to just fit the taller page's actual content (the
    // sliders page bottoms out around 208 units) plus PositionPages()'s
    // 30-unit header/margin inset (24 top + 6 bottom), with a small buffer.
    // This trims the slack that used to sit below both pages -- the sliders
    // page had ~10 units of unused space at the bottom, and the options page
    // (which has less content) had even more.
    CONTROL         "", IDC_TAB, "SysTabControl32", WS_TABSTOP, 10, 126, 280, 240

    // Buttons moved up to sit right under the now-shorter tab control,
    // keeping the same 10-unit gap that existed before.
    PUSHBUTTON      "Reset to Defaults", IDC_RESET, 10, 376, 90, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 376, 44, 14
    DEFPUSHBUTTON   "Save", IDOK, 246, 376, 44, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Chewie"
            VALUE "FileDescription",  "Matrix Reflow"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MatrixReflow"
            VALUE "OriginalFilename", "MatrixReflow.scr"
            VALUE "ProductName",      "Matrix Reflow"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END